# Copy to .env and fill in. Used by docker-compose (local) and as a reference
# for the Terraform variables (cloud).

# REQUIRED: bearer key for POST /tx, /block, /mine. Generate a strong one:
#   openssl rand -hex 32
SMARTSV_API_KEY=changeme-generate-with-openssl-rand-hex-32

# Address the seed node mines to (create with: node bin/smartsv.js newkey).
MINE_ADDRESS=

# Public FQDN for TLS. Leave as :80 for local HTTP; set to your domain in prod
# (DNS A record must point at the droplet) for automatic Let's Encrypt HTTPS.
DOMAIN=:80
